<Window x:Class="ContainerToDrive.Desktop.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renew access" Style="{StaticResource AppWindow}" Width="620" Height="550" MinWidth="540" MinHeight="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="OnClosing" Closed="OnClosed">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20">
      <TextBlock Text="Renew access" FontSize="28" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" Margin="0,8,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel x:Name="Fields">
        <Border Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,20">
          <TextBlock x:Name="RenewalWarning" Text="Use a replacement credential for this same container. Renewal does not clear the cache or resolve uncertain uploads by itself." Foreground="{DynamicResource WarningTextBrush}" />
        </Border>
        <StackPanel x:Name="SecretPanel">
          <Label x:Name="SecretLabel" Content="Replacement container _SAS URL" Target="{Binding ElementName=SecretBox}" />
          <PasswordBox x:Name="SecretBox" MaxLength="16384" AutomationProperties.Name="Replacement cloud credential, secret" />
          <TextBlock Text="The secret is sent only to the controller and cleared after every attempt. Never paste it into a support issue." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel x:Name="EntraRenewalPanel" Visibility="Collapsed">
          <TextBlock Text="Select Renew access to sign in through Microsoft and request a new one-day read/list user delegation credential for this same container." Style="{StaticResource Muted}" />
          <TextBlock Text="If tenant consent, delegation-key permission, or the selected mode's Blob Data Reader/Contributor role is missing, Azure will deny renewal and the existing protected credential is retained." Style="{StaticResource Muted}" Margin="0,10,0,0" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Renewing credential" Margin="0,0,0,10" />
      <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,14" />
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="_Cancel" Click="OnCancel" Margin="0,0,10,6" />
        <Button x:Name="RenewButton" Content="_Renew access" Click="OnRenew" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0,0,0,6" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>